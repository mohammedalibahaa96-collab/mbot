# Copy to .env on the machine running the API. Never commit .env or place keys in frontend code.
PORT=3001

# Required before account balances or paid AI commentary are served. Generate a long random value.
MBOT_ACCESS_TOKEN=

# Optional, read-only account display. Use separate keys and revoke any key ever shared in chat.
# Keep withdrawals and futures trading permissions disabled for dashboard-only access.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET_KEY=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Optional: enables manual Spot Testnet market orders only; never enables mainnet orders.
ENABLE_TESTNET_ORDERS=false
MBOT_TESTNET_MAX_ORDER_USDT=25

# Optional advisory text only. The AI endpoint cannot place orders.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
